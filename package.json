{
  "name": "popagent",
  "version": "0.1.0",
  "description": "Pop an AI agent into tmux + iTerm2 from a prompt (macOS)",
  "type": "module",
  "bin": {
    "popagent": "dist/popagent.js"
  },
  "files": [
    "dist",
    "resources",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "Takaichi Hase (@tkqubo)",
  "homepage": "https://github.com/tkqubo/popagent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkqubo/popagent.git"
  },
  "bugs": {
    "url": "https://github.com/tkqubo/popagent/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "tmux",
    "iterm",
    "iterm2",
    "macos",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "bun popagent.ts",
