{
  "pr-polling": {
    "workspaces": [
      "/path/to/repo",
      { "path": "/path/to/parent/dir", "recursive": true }
    ],
    "ai_agent_command": "claude {comment}",
    "repos": [
      "your_org/your_repo"
    ],
    "poll_interval_sec": 30,
    "state_path": ".state/last_seen.json",
    "auto_attach": true
  }
}
